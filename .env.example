# ─────────────────────────────────────────────────────────────
#  InkForum configuration
#  install.sh creates this file for you. For a manual install, copy it to .env.
#  Forum name, theme, e-mail and everything else is configured in the admin panel after setup.
# ─────────────────────────────────────────────────────────────

# Public address of the site (no trailing /). A domain with HTTPS is recommended.
APP_URL=http://localhost:3000

# Session and encryption key: at least 32 random characters. Changing it signs everyone out.
APP_SECRET=

# Shared key between the updater container and the app (at least 16 characters)
UPDATER_TOKEN=

# Language used before setup is finished (setup wizard, first defaults):
# en | tr | de | es | fr | pt | ru | zh — empty: the visitor's browser language decides.
# After setup, the default language is changed in Admin → Language.
DEFAULT_LOCALE=

# Real visitor IP behind a reverse proxy: loopback | uniquelocal | true | list of IPs
# "uniquelocal" is right for Docker + Caddy/Nginx/Traefik.
TRUST_PROXY=uniquelocal

# ── Docker ───────────────────────────────────────────────────
# latest is recommended: updates are installed from the admin panel.
INKFORUM_VERSION=latest
INKFORUM_PORT=3000
# Set to 127.0.0.1 when Caddy/Nginx sits in front (the app port is not exposed)
INKFORUM_BIND=0.0.0.0

# Optional components: https (Caddy with automatic certificates), postgres
# Example: COMPOSE_PROFILES=https,postgres
COMPOSE_PROFILES=
# Your domain when COMPOSE_PROFILES=https (DNS must point to this server)
DOMAIN=

# ── Database ─────────────────────────────────────────────────
# sqlite (default, nothing else to install) | postgres
DB_DRIVER=sqlite
# With DB_DRIVER=postgres (add postgres to COMPOSE_PROFILES):
# POSTGRES_PASSWORD=a-strong-password
# DATABASE_URL=postgres://inkforum:a-strong-password@postgres:5432/inkforum

# ── Advanced ─────────────────────────────────────────────────
# E-mail is configured after setup in Admin → E-mail.
# Turn off update checks entirely (offline servers):
# UPDATES_DISABLED=true
# Turn off the web application firewall in an emergency:
# WAF_DISABLED=true
