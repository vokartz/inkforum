# ─────────────────────────────────────────────────────────────
#  InkForum yapılandırması
#  install.sh bu dosyayı sizin için oluşturur. Elle kuruyorsanız .env olarak kopyalayın.
#  Forum adı, tema, e-posta ve diğer her şey kurulumdan sonra yönetim panelinden ayarlanır.
# ─────────────────────────────────────────────────────────────

# Sitenin tarayıcıdaki adresi (sonunda / olmadan). Alan adı + HTTPS önerilir.
APP_URL=http://localhost:3000

# Oturum ve şifreleme anahtarı: en az 32 rastgele karakter. Değiştirirseniz tüm oturumlar kapanır.
APP_SECRET=

# Güncelleyici kapsayıcı ile uygulama arasındaki paylaşılan anahtar (en az 16 karakter)
UPDATER_TOKEN=

# Ters vekil arkasında gerçek ziyaretçi IP'si için: loopback | uniquelocal | true | IP listesi
# Docker + Caddy/Nginx/Traefik kullanıyorsanız "uniquelocal" doğru seçimdir.
TRUST_PROXY=uniquelocal

# ── Docker ───────────────────────────────────────────────────
# latest önerilir: güncellemeleri yönetim paneli kurar.
INKFORUM_VERSION=latest
INKFORUM_PORT=3000
# Önünde Caddy/Nginx varsa 127.0.0.1 yapın (uygulama portu dışarı açılmaz)
INKFORUM_BIND=0.0.0.0

# İsteğe bağlı bileşenler: https (Caddy ile otomatik sertifika), postgres
# Örnek: COMPOSE_PROFILES=https,postgres
COMPOSE_PROFILES=
# COMPOSE_PROFILES=https ise alan adınız (DNS bu sunucuyu göstermeli)
DOMAIN=

# ── Veritabanı ───────────────────────────────────────────────
# sqlite (varsayılan, ek kurulum gerekmez) | postgres
DB_DRIVER=sqlite
# DB_DRIVER=postgres ise (COMPOSE_PROFILES içine postgres ekleyin):
# POSTGRES_PASSWORD=guclu-bir-sifre
# DATABASE_URL=postgres://inkforum:guclu-bir-sifre@postgres:5432/inkforum

# ── Gelişmiş ─────────────────────────────────────────────────
# E-posta: kurulumdan sonra Yönetim → E-posta ekranından ayarlanır.
# Güncelleme denetimini tamamen kapatmak için (internetsiz sunucular):
# UPDATES_DISABLED=true
# Güvenlik duvarını acil durumda devre dışı bırakmak için:
# WAF_DISABLED=true
