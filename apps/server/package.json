{
  "name": "@forum/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "node scripts/swc.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "pnpm build && node --env-file-if-exists=../../.env dist/cli.js migrate",
    "db:seed:dev": "pnpm build && node --env-file-if-exists=../../.env dist/cli.js seed-dev",
    "test:pg": "TEST_DB_DRIVER=pglite vitest run"
  },
  "dependencies": {
    "@forum/db": "workspace:*",
    "@forum/shared": "workspace:*",
    "@jitl/quickjs-singlefile-mjs-release-sync": "^0.32.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@node-rs/argon2": "^2.2.1",
    "@phosphor-icons/core": "^2.1.1",
    "@twemoji/svg": "^15.0.0",
    "express": "^5.2.1",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.3.0",
    "kysely": "^0.29.6",
    "lru-cache": "^11.5.3",
    "lucide": "^1.48.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "quickjs-emscripten-core": "^0.32.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@inkforum/sdk": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/testing": "^11.2.6",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.12",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "chokidar": "^5.0.0",
    "supertest": "^7.3.0",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
