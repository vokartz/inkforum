# ─────────────────────────────────────────────────────────────
# InkForum geliştirme yapılandırması
# Bu dosyayı .env olarak kopyalayın. Docker / üretim için .env.example dosyasına bakın.
# ─────────────────────────────────────────────────────────────

# development | production
NODE_ENV=development

# Tarayıcının gördüğü adres. Geliştirmede Vite (5173), üretimde kendi alan adınız.
APP_URL=http://localhost:5173
PORT=3000
HOST=0.0.0.0

# En az 32 karakter. Boş bırakılırsa storage/.app-secret içinde otomatik üretilir.
# APP_SECRET=

# Ters vekil (nginx/Apache/Passenger) arkasındaysanız: loopback | true | 1 | IP listesi
TRUST_PROXY=loopback

# ── Veritabanı ───────────────────────────────────────────────
# sqlite (varsayılan, ek kurulum gerektirmez) | postgres
DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/forum.db
# auto | node | better
SQLITE_DRIVER=auto
# WAL | DELETE  (ağ dosya sistemlerinde DELETE kullanın)
SQLITE_JOURNAL=WAL
# DB_DRIVER=postgres ise:
# DATABASE_URL=postgres://kullanici:sifre@localhost:5432/forum

STORAGE_DIR=storage

# ── E-posta ──────────────────────────────────────────────────
# log (storage/mail içine yazar) | smtp | sendmail
MAIL_DRIVER=log
# SMTP_URL=smtp://kullanici:sifre@smtp.ornek.com:587
# SENDMAIL_PATH=/usr/sbin/sendmail

# ── Görseller ────────────────────────────────────────────────
# auto (sharp yüklüyse kullanır) | sharp | passthrough
IMAGE_DRIVER=auto

# ── İlk kurulum ──────────────────────────────────────────────
# Hiç yönetici yoksa site /install kurulum sihirbazına yönlenir; kurulum kodu konsola ve
# storage/INSTALL_CODE.txt dosyasına yazılır. Kodu sabitlemek için:
# INSTALL_CODE=ABCD-2345
# Sihirbazı atlayıp otomatik kurulum (CI, otomasyon): ADMIN_PASSWORD verilirse yönetici bu bilgilerle oluşturulur.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# ── Güncellemeler ────────────────────────────────────────────
# Sürümlerin okunduğu GitHub deposu ve (Docker'da) güncelleyici kapsayıcı
# UPDATE_REPO=vokartz/inkforum
# UPDATES_DISABLED=true
# UPDATER_URL=http://updater:9000
# UPDATER_TOKEN=

# Geliştirme: Vite'ın SSR sırasında API'ye ulaşacağı adres
INTERNAL_API_URL=http://127.0.0.1:3000
